year\n","  E_mech = w_per_kg * annual_mass_kg\n","\n","  # prep for 动能回收的workflow control, 先放着做准备\n","  if E_mech < 0:\n","      E_elec = (1.0 - regen_fraction) * E_mech\n","  else:\n","      E_elec = E_mech / max(efficiency, 1e-9)\n","\n","  # kWh and money🎵\n","  E_kwh = joule_to_kwh(E_elec)\n","  cost = E_kwh * electricity_price_per_kwh\n","\n","  return {\n","        \"r1_m\": r1_m,\n","        \"r2_m\": r2_m,\n","        \"work_per_kg_J\": w_per_kg,\n","        \"work_per_kg_kWh\": joule_to_kwh(w_per_kg),\n","        \"annual_mass_kg\": annual_mass_kg,\n","        \"annual_energy_J\": E_elec,\n","        \"annual_energy_kWh\": E_kwh,\n","        \"annual_electricity_cost_$\": cost\n","    }"],"metadata":{"id":"75EwGytq4A-u"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["result = annual_elevator_energy_cost(\n","        annual_mass_tons=179_000*3,\n","        tether_length_km=100_000,\n","        efficiency=0.85, # whatever, can be changed\n","        regen_fraction=0.0,  # basic的lift only model将这个留为0\n","        electricity_price_per_kwh=0.20 # 电费，自定\n","    )\n","\n","print(\"=== Space Elevator Basic Energy Model ===\")\n","print(f\"Start radius r1 = {result['r1_m']:.3e} m\")\n","print(f\"End radius   r2 = {result['r2_m']:.3e} m (R_E + tether)\")\n","print(f\"Work per kg  = {result['work_per_kg_J']:.3e} J/kg\")\n","print(f\"           = {result['work_per_kg_kWh']:.3f} kWh/kg\")\n","print(f\"Annual mass  = {result['annual_mass_kg']:.3e} kg\")\n","print(f\"Annual energy= {result['annual_energy_kWh']:.3e} kWh\")\n","print(f\"Elec cost/yr = ${result['annual_electricity_cost_$']:.3e}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bYKB5kP94X8E","executionInfo":{"status":"ok","timestamp":1770600935700,"user_tz":480,"elapsed":6,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}},"outputId":"0ffd0696-f1b7-4096-c63d-daf728e7a818"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text