: losses,\n","        \"Boosters Built\": boosters_built,\n","        \"Hardware Cost ($B)\": hardware_cost / 1e9,\n","        \"Ops Cost ($B)\": ops_cost / 1e9,\n","        \"Cargo Cost ($B)\": cargo_cost / 1e9,\n","        \"Total Cost ($B)\": total_cost / 1e9,\n","    }\n"]},{"cell_type":"markdown","source":["### Yearly Schedule"],"metadata":{"id":"sfbnmc28B_oA"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"b87kwTGw5Xrw","executionInfo":{"status":"ok","timestamp":1770600940076,"user_tz":480,"elapsed":4335,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}},"outputId":"a6275566-6409-4665-f03d-306cdbc6e8bc"},"outputs":[{"output_type":"stream","name":"stdout","text":["Calculating Pareto Front from 2090 to 2250...\n","\n","--- PARETO FRONTIER SAMPLE (Cost vs Time) ---\n","   Duration_Years  Finish_Year  Total_Cost_Billions  Elevator_Share_Pct  \\\n","0              62         2112             570212.4              33.294   \n","1              63         2113             567312.6              33.831   \n","2              64         2114             564412.8              34.368   \n","3              65         2115             561513.0              34.905   \n","4              66         2116             558613.2              35.442   \n","5              67         2117             555713.4              35.979   \n","6              68         2118             552813.6              36.516   \n","7              69         2119             549913.8              37.053   \n","8              70         2120             547014.0              37.590   \n","9              71         2121             544114.2              38.127   \n","\n","   Rocket_Share_Pct  \n","0            66.706  \n","1            66.169  \n","2            65.632  \n","3            65.095  \n","4            64.558  \n","5            64.021  \n","6            63.484  \n","7            62.947  \n","8            62.410  \n","9            61.873  \n","...\n","     Duration_Years  Finish_Year  Total_Cost_Billions  Elevator_Share_Pct  \\\n","134             196         2246             210000.0               100.0   \n","135             197         2247             210000.0               100.0   \n","136             198         2248             210000.0               100.0   \n","137             199         2249             210000.0               100.0   \n","138             200         2250             210000.0               100.0   \n","\n","     Rocket_Share_Pct  \n","134               0.0  \n","135               0.0  \n","136               0.0  \n","137               0.0  \n","138               0.0  \n"]}],"source":["def solve_yearly_pareto(\n","    target_mass=100_000_000,\n","    start_year=2050,\n","    min_years=10,\n","    max_years=200\n","):\n","    \"\"\"\n","    Calculates the Pareto Efficient Frontier for Time vs. Cost.\n","    For every deadline year (tau), minimizes cost to meet demand.\n","    \"\"\"\n","\n","    # --- Parameters ---\n","    # 1.Space Elevator\n","    # 3 Harbours * 179,000 tons/yr = 537,000 tons/yr\n","    CAP_ELEV_YEAR = 537_000\n","    COST_ELEV_PER_TON = 2100000  # $2100000/ton (Electricity + Maintenance)\n","\n","    # 2.Rockets\n","    # 10 Sites. Assume \"Daily\" cadence is possible in peak surges.\n","    # 10 sites * 365 days * 150 tons = 547,500 tons/yr\n","    # NOTE: We can scale this up if we assume multiple pads per site.\n","    # Let's assume a \"Maximum Surge\" capability of 2x daily launches global.\n","    CAP_ROCKET_YEAR = 10 * 365 * 150 * 2\n","    COST_ROCKET_PER_TON = 7500000 # $7500000/ton (Fuel + Hardware). High cost penalty.\n","\n","    results = []\n","\n","    print(f\"Calculating Pareto Front from {start_year + min_years} to {start_year + max_years}...\")\n","\n","    # Loop through possible durations\n","    for duration in range(min_years, max_years + 1):\n","        finish_year = start_year + duration\n","\n","        prob = pulp.LpProblem(f\"Pareto_Year_{finish_year}\", pulp.LpMinimize)\n","\n","        # variables: mass shipped per year for elevator and rockets\n","        E = pulp.LpVariable.dicts(\"Elev_Mass\", range(1, duration + 1), lowBound=0)\n","        R = pulp.LpVariable.dicts(\"Rkt_Mass\", range(1, duration + 1), lowBound=0)\n","\n","        # objective: minimize total cost\n","        prob += pulp.lpSum(\n","            (E[t] * COST_ELEV_PER_TON) + (R[t] * COST_ROCKET_PER_TON)\n","            for t in range(1, duration + 1)\n","        )\n","\n","        # total mass\n","        prob += pulp.lpSum(E[t] + R[t] for t in range(1, duration + 1)) >= target_mass\n","\n","        # capacity each year\n","        for t in range(1, duration + 1):\n","            prob += E[t] <= CAP_ELEV_YEAR\n","            prob += R[t] <= CAP_ROCKET_YEAR\n","\n","        prob.solve(pulp.PULP_CBC_CMD(msg=False))\n","\n","        if pulp.LpStatus[prob.status] == \"Optimal\":\n","            total_cost = pulp.value(prob.objective)\n","            total_elev_mass = sum(pulp.value(E[t]) for t in range(1, duration + 1))\n","            total_rkt_mass = sum(pulp.value(R[t]) for t in range(1, duration + 1))\n","\n","            results.append({\n","                \"Duration_Years\": duration,\n","                \"Finish_Year\": finish_year,\n","                \"Total_Cost_Billions\": total_cost / 1e9,\n","                \"Elevator_Share_Pct\": (total_elev_mass / target_mass) * 100,\n","                \"Rocket_Share_Pct\": (total_rkt_mass / target_mass) * 100\n","            })\n","        else:\n","            pass\n","\n","    return pd.DataFrame(results)\n","\n","df_pareto = solve_yearly_pareto(min_years=40, max_years=200)\n","print(\"\\n--- PARETO FRONTIER SAMPLE (Cost vs Time) ---\")\n","print(df_pareto.head(10)) # fast, expensive\n","print(\"...\")\n","print(df_pareto.tail(5))  # slow, cheap"]},{"cell_type":"code","source":["plt.figure(figsize=(10,6))\n","plt.plot(df_pareto['Finish_Year'], df_pareto['Total_Cost_Billions'], marker='o')\n","plt.title('Moon Colony Logistics: Time vs. Cost Trade-off')\n","plt.xlabel('Completion Year')\n","plt.ylabel('Total Cost ($ Billions)')\n","plt.grid(True)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":564},"id":"Yrk9cRmXB4rF","executionInfo":{"status":"ok","timestamp":1770600940404,"user_tz":480,"elapsed":322,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}},"outputId":"8b106a0b-99ae-4b4e-a91a-8ac7855c6fc7"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"4K0bMOIxlQmg"},"source":["## Problem 2 (Evaluate Risks)"]},{"cell_type":"markdown","source":["Latitude: cost difference\n","\n","Rocket Failure: 2-5% (doesn't need to maintenance) 2%\n","\n","Tensile (swaying):\n","\n","Climber Failure: 0.0001% (needs maintenance) maintenance 停三十天 maintenance cost 5billion.\n","85M/yr"],"metadata":{"id":"_v0q9EQB5T5z"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uYkTvPn_lS7I","executionInfo":{"status":"ok","timestamp":1770600968741,"user_tz":480,"elapsed":28337,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}},"outputId":"98ae3b23-f0eb-43a2-8f7b-be7b47e0c8a7"},"outputs":[{"output_type":"stream","name":"stdout","text":["{'launches_per_year': 1341, 'climbs_per_year': 10740, 'p_elevator_fail_per_year': 0.010682537431958683, 'expected_elevator_failures_over_149y': 1.5916980773618437, 'mean_years': 150.00422, 'p95_years': 150.0, 'prob_151_or_more': 0.00422, 'mean_total_cost': 329102663630074.25, 'p95_total_cost': 329233434000000.0}\n"]}],"source":["def monte_carlo_q2(\n","    T=100_000_000,                 # tons\n","    years_plan=149,\n","    K_E=537_000,                    # tons/year elevator throughput (3 harbours)\n","    tons_per_launch=100,            # rocket payload\n","    pR_fail=0.02,                   # rocket failure per launch (2050)\n","    pE_fail_per_climb=1e-6,         # 0.0001% per climb\n","    shutdown_days=30,\n","    repair_cost=5e9,                # $5B per elevator failure\n","    maint_per_year=85e6,            # $85M/year\n","    # costs\n","    launch_cost=795e6,              # $/launch (paid even if failed)\n","    C_E=2.10188e6,                  # $/ton delivered via elevator channel (your model)\n","    tons_per_climb=50,              # q: tons/climb\n","    N=50000, # trials\n","    seed=0,\n","    max_years=400\n","):\n","    rng = np.random.default_rng(seed)\n","\n","    # Deterministic 149-year split: elevator saturated, rockets deliver remainder\n","    rocket_total = T - years_plan * K_E\n","    rocket_per_year = rocket_total / years_plan\n","    launches_per_year = int(round(rocket_per_year / tons_per_launch))\n","\n","    # Climbs per year (when not down)\n","    climbs_per_year = int(round(K_E / tons_per_climb))\n","\n","    # Annual probability of at least one elevator failure\n","    q_fail_year = 1 - (1 - pE_fail_per_climb) ** climbs_per_year\n","\n","    # If failure occurs, lose 30 days worth of elevator throughput that year\n","    loss_frac = shutdown_days / 365.0\n","    elev_full = K_E\n","    elev_reduced = K_E * (1 - loss_frac)\n","\n","    rocket_cost_year = launches_per_year * launch_cost\n","\n","    years_needed = np.empty(N, dtype=np.int16)\n","    total_cost = np.empty(N, dtype=np.float64)\n","\n","    for i in range(N):\n","        delivered = 0.0\n","        cost = 0.0\n","        y = 0\n","\n","        while delivered < T and y < max_years:\n","            # Elevator: yearly failure event\n","            elev_failed = rng.random() < q_fail_year\n","            delivered_e = elev_reduced if elev_failed else elev_full\n","            delivered += delivered_e\n","\n","            # Elevator costs: variable cost only when it delivers + always-on maintenance\n","            cost += delivered_e * C_E\n","            cost += maint_per_year\n","            if elev_failed:\n","                cost += repair_cost\n","\n","            # Rockets: launches attempted always, delivery reduced by failures\n","            successes = rng.binomial(launches_per_year, 1 - pR_fail)\n","            delivered += successes * tons_per_launch\n","            cost += rocket_cost_year\n","\n","            y += 1\n","\n","        years_needed[i] = y\n","        total_cost[i] = cost\n","\n","    summary = {\n","        \"launches_per_year\": launches_per_year,\n","        \"climbs_per_year\": climbs_per_year,\n","        \"p_elevator_fail_per_year\": q_fail_year,\n","        \"expected_elevator_failures_over_149y\": q_fail_year * years_plan,\n","        \"mean_years\": float(years_needed.mean()),\n","        \"p95_years\": float(np.quantile(years_needed, 0.95)),\n","        \"prob_151_or_more\": float(np.mean(years_needed >= 151)),\n","        \"mean_total_cost\": float(total_cost.mean()),\n","        \"p95_total_cost\": float(np.quantile(total_cost, 0.95)),\n","    }\n","    return summary\n","\n","\n","# test\n","print(monte_carlo_q2(tons_per_climb=50, N=50000))\n"]},{"cell_type":"markdown","metadata":{"id":"3EVhi3DBLQjp"},"source":["# Sensitivity Analysis"]},{"cell_type":"markdown","metadata":{"id":"u9ydezmvMJQq"},"source":["## 1C"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"howdvuXnLZ0V"},"outputs":[],"source":["# Baseline parameters\n","T0 = 100_000_000\n","K_E0 = 537_000\n","K_R0 = 365_000\n","C_E0 = 2.10188e6\n","C_R0 = 7.95e6\n","start_year = 2050\n"]},{"cell_type":"code","source":["def stage3_balanced(T=T0, K_E=K_E0, K_R=K_R0, C_E=C_E0, C_R=C_R0):\n","    tau_min = math.ceil(T/(K_E+K_R))\n","    tau_E = math.ceil(T/K_E)\n","    tau_bal = round((tau_min + tau_E)/2)\n","    # rocket share\n","    rocket_tons = max(0.0, T - tau_bal*K_E)\n","    rocket_share = rocket_tons / T\n","    # total cost, saturate elevator then rockets\n","    total_cost = (tau_bal*K_E*C_E) + (rocket_tons*C_R)\n","    year_goal = start_year + tau_bal\n","    return tau_min, tau_E, tau_bal, year_goal, rocket_share, total_cost"],"metadata":{"id":"Imd2hPlw5pgi"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Scenarios for OAT sensitivity\n","scenarios = [\n","    (\"Baseline\", dict()),\n","    (\"K_E -20%\", dict(K_E=K_E0*0.8)),\n","    (\"K_E +20%\", dict(K_E=K_E0*1.2)),\n","    (\"K_R -20%\", dict(K_R=K_R0*0.8)),\n","    (\"K_R +20%\", dict(K_R=K_R0*1.2)),\n","    (\"T -20%\", dict(T=T0*0.8)),\n","    (\"T +20%\", dict(T=T0*1.2)),\n","    (\"C_E -50%\", dict(C_E=C_E0*0.5)),\n","    (\"C_E +50%\", dict(C_E=C_E0*1.5)),\n","    (\"C_R -30%\", dict(C_R=C_R0*0.7)),\n","    (\"C_R +30%\", dict(C_R=C_R0*1.3)),\n","]\n","\n","rows = []\n","for name, overrides in scenarios:\n","    params = dict(T=T0, K_E=K_E0, K_R=K_R0, C_E=C_E0, C_R=C_R0)\n","    params.update(overrides)\n","    tau_min, tau_E, tau_bal, year_goal, rocket_share, total_cost = stage3_balanced(**params)\n","    rows.append({\n","        \"Scenario\": name,\n","        \"tau_min\": tau_min,\n","        \"tau_E\": tau_E,\n","        \"tau_bal\": tau_bal,\n","        \"Year_goal\": year_goal,\n","        \"Rocket_share\": rocket_share,\n","        \"Total_cost_T$\": total_cost/1e12,\n","    })\n","\n","df = pd.DataFrame(rows)\n","df"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":394},"id":"DgCilo3s5s_m","executionInfo":{"status":"ok","timestamp":1770600968769,"user_tz":480,"elapsed":15,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}},"outputId":"1da7ab80-c275-4101-e60f-26494989b0b8"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["    Scenario  tau_min  tau_E  tau_bal  Year_goal  Rocket_share  Total_cost_T$\n","0   Baseline      111    187      149       2199      0.199870     327.074374\n","1   K_E -20%      126    233      180       2230      0.226