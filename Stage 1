(rocket_per_year / tons_per_launch))  # launches/year\n","\n","    # Convert per-climb failure to annual failure probability\n","    climbs_per_year = int(round(K_E / tons_per_climb))\n","    q_fail_year = 1 - (1 - pE_fail_per_climb) ** climbs_per_year if climbs_per_year > 0 else 0.0\n","\n","    # Elevator delivery reduction when a failure occurs in that year (annual approximation)\n","    loss_frac = shutdown_days / 365.0\n","    elev_full = K_E\n","    elev_reduced = K_E * (1 - loss_frac)\n","\n","    # Sample N x max_years years of random outcomes\n","    elev_fail = rng.random((N, max_years)) < q_fail_year\n","    elev_deliv = np.where(elev_fail, elev_reduced, elev_full).astype(float)\n","\n","    if L > 0:\n","        successes = rng.binomial(L, 1 - pR_fail, size=(N, max_years))\n","        rkt_deliv = successes.astype(float) * tons_per_launch\n","    else:\n","        rkt_deliv = np.zeros((N, max_years), dtype=float)\n","\n","    yearly_deliv = elev_deliv + rkt_deliv\n","    cum_deliv = np.cumsum(yearly_deliv, axis=1)\n","    reached = cum_deliv >= T\n","    first_idx = np.argmax(reached, axis=1)   # first year reaching target (0-based)\n","    years_needed = first_idx + 1\n","\n","    # Costs (paid yearly until completion year)\n","    rocket_cost_year = L * launch_cost\n","    yearly_cost = (\n","        elev_deliv * C_E\n","        + maint_per_year\n","        + elev_fail.astype(float) * repair_cost\n","        + rocket_cost_year\n","    )\n","    cum_cost = np.cumsum(yearly_cost, axis=1)\n","    total_cost = cum_cost[np.arange(N), first_idx]\n","\n","    return {\n","        \"launches_per_year\": L,\n","        \"climbs_per_year\": climbs_per_year,\n","        \"p_elevator_fail_per_year\": float(q_fail_year),\n","        \"exp_elev_fail_149y\": float(q_fail_year * years_plan),\n","        \"mean_years\": float(years_needed.mean()),\n","        \"p95_years\": float(np.quantile(years_needed, 0.95)),\n","        \"prob_ge_151\": float(np.mean(years_needed >= 151)),\n","        \"mean_cost_T$\": float(total_cost.mean() / 1e12),\n","        \"p95_cost_T$\": float(np.quantile(total_cost, 0.95) / 1e12),\n","    }\n","\n","def run_q2_sensitivity():\n","    base = dict(\n","        N=20000, seed=1, max_years=250,\n","        tons_per_climb=50, pR_fail=0.02, pE_fail_per_climb=1e-6,\n","        shutdown_days=30, repair_cost=5e9, maint_per_year=85e6\n","    )\n","\n","    scenarios = []\n","    def add(name, **kw): scenarios.append((name, kw))\n","\n","    # Rocket failure\n","    for p in [0.01, 0.02, 0.05]:\n","        add(f\"Rocket failure p_R={p:.0%}\", pR_fail=p)\n","\n","    # Elevator per-climb failure\n","    for p in [1e-7, 1e-6, 1e-5]:\n","        add(f\"Elevator per-climb p_E={p:.0e}\", pE_fail_per_climb=p)\n","\n","    # Shutdown duration\n","    for d in [15, 30, 60]:\n","        add(f\"Shutdown {d} days\", shutdown_days=d)\n","\n","    # Repair cost\n","    for c in [2e9, 5e9, 1e10]:\n","        add(f\"Repair cost ${c/1e9:.0f}B\", repair_cost=c)\n","\n","    # Tons per climb\n","    for q in [50, 490]:\n","        add(f\"Tons per climb q={q}\", tons_per_climb=q)\n","\n","    # Maintenance\n","    for m in [50e6, 85e6, 150e6]:\n","        add(f\"Maintenance ${m/1e6:.0f}M/yr\", maint_per_year=m)\n","\n","    rows = []\n","    for name, kw in scenarios:\n","        params = base.copy()\n","        params.update(kw)\n","        r = monte_carlo_q2_vec(**params)\n","        r[\"Scenario\"] = name\n","        rows.append(r)\n","\n","    df = pd.DataFrame(rows)\n","    return df\n","\n","df_sens = run_q2_sensitivity()\n","print(df_sens[[\"Scenario\",\"mean_years\",\"p95_years\",\"prob_ge_151\",\"mean_cost_T$\",\"p95_cost_T$\",\n","               \"p_elevator_fail_per_year\",\"exp_elev_fail_149y\"]])\n"]},{"cell_type":"markdown","metadata":{"id":"XIfH95fDLm-C"},"source":["# graphing"]},{"cell_type":"markdown","source":["## stage 1"],"metadata":{"id":"i_fGs3Chxy6U"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":620},"id":"VwpJFhGEFjiv","executionInfo":{"status":"ok","timestamp":1770601007443,"user_tz":480,"elapsed":2061,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}},"outputId":"89febf94-2898-4267-a56b-3655ec5c0f3d"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1100x650 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# --- Parameters (paper-consistent) ---\n","T = 100_000_000          # Mt total\n","K_E = 537_000            # Mt/year (3 * 179,000)\n","K_R = 365_000            # Mt/year (10 sites * 365 days * 100 Mt/launch)\n","C_E = 2.10188e6          # $/Mt\n","C_R = 7.95e6             # $/Mt\n","start_year = 2050\n","\n","tau_min = int(np.ceil(T / (K_E + K_R)))\n","tau_E   = int(np.ceil(T / K_E))\n","\n","taus = np.arange(tau_min, tau_E + 1)\n","\n","rows = []\n","for tau in taus:\n","    elev_total = min(T, tau * K_E)\n","    rocket_total = max(0.0, T - elev_total)\n","    if rocket_total > tau * K_R + 1e-9:\n","        continue\n","    total_cost = elev_total * C_E + rocket_total * C_R\n","    rows.append((tau, start_year + tau, total_cost / 1e12))\n","\n","df = pd.DataFrame(rows, columns=[\"tau_years\",\"completion_year\",\"total_cost_trillion\"])\n","\n","# Balanced point (your paper choice)\n","tau_bal = 149\n","row_bal = df.loc[df[\"tau_years\"] == tau_bal].iloc[0]\n","year_bal = int(row_bal[\"completion_year\"])\n","cost_bal = float(row_bal[\"total_cost_trillion\"])\n","\n","# --- Fancy plot ---\n","fig, ax = plt.subplots(figsize=(11, 6.5))\n","\n","ax.plot(df[\"completion_year\"], df[\"total_cost_trillion\"],\n","        linewidth=2.2, marker=\"o\", markersize=4.2)\n","\n","# Emphasize endpoints + balance point\n","ax.plot([df[\"completion_year\"].iloc[0]], [df[\"total_cost_trillion\"].iloc[0]],\n","        marker=\"o\", markersize=7.5, linestyle=\"None\")\n","ax.plot([df[\"completion_year\"].iloc[-1]], [df[\"total_cost_trillion\"].iloc[-1]],\n","        marker=\"o\", markersize=7.5, linestyle=\"None\")\n","ax.plot([year_bal], [cost_bal],\n","        marker=\"o\", markersize=9.0, linestyle=\"None\")\n","\n","# Guide lines\n","ax.axvline(df[\"completion_year\"].iloc[0], linestyle=\"--\", linewidth=1.0)\n","ax.axvline(year_bal, linestyle=\"--\", linewidth=1.0)\n","ax.axvline(df[\"completion_year\"].iloc[-1], linestyle=\"--\", linewidth=1.0)\n","\n","# Annotations\n","ax.annotate(f\"Earliest feasible\\nτ={tau_min} (Year {int(df['completion_year'].iloc[0])})\",\n","            xy=(df[\"completion_year\"].iloc[0], df[\"total_cost_trillion\"].iloc[0]),\n","            xytext=(df[\"completion_year\"].iloc[0] + 4, df[\"total_cost_trillion\"].iloc[0] + 25),\n","            arrowprops=dict(arrowstyle=\"->\", linewidth=1.0),\n","            fontsize=10, ha=\"left\", va=\"bottom\")\n","\n","ax.annotate(f\"Balanced choice\\nτ={tau_bal} (Year {year_bal})\\nCost ≈ {cost_bal:.1f}T\",\n","            xy=(year_bal, cost_bal),\n","            xytext=(year_bal + 6, cost_bal + 25),\n","            arrowprops=dict(arrowstyle=\"->\", linewidth=1.0),\n","            fontsize=10, ha=\"left\", va=\"bottom\")\n","\n","ax.annotate(f\"Elevator-only limit\\nτ={tau_E} (Year {int(df['completion_year'].iloc[-1])})\",\n","            xy=(df[\"completion_year\"].iloc[-1], df[\"total_cost_trillion\"].iloc[-1]),\n","            xytext=(df[\"completion_year\"].iloc[-1] - 2, df[\"total_cost_trillion\"].iloc[-1] + 35),\n","            arrowprops=dict(arrowstyle=\"->\", linewidth=1.0),\n","            fontsize=10, ha=\"right\", va=\"bottom\")\n","\n","# Secondary x-axis: τ on top\n","def year_to_tau(x): return x - start_year\n","def tau_to_year(x): return x + start_year\n","secax = ax.secondary_xaxis('top', functions=(year_to_tau, tau_to_year))\n","secax.set_xlabel(\"Project duration τ (years)\")\n","\n","# Labels/title\n","ax.set_title(\"Stage 1 Pareto Frontier (Hybrid Logistics): Completion Year vs Total Cost\", pad=12)\n","ax.set_xlabel(\"Completion year\")\n","ax.set_ylabel(\"Total cost (trillion $)\")\n","\n","ax.set_xlim(df[\"completion_year\"].min() - 2, df[\"completion_year\"].max() + 2)\n","ax.set_xticks(np.arange(df[\"completion_year\"].min(), df[\"completion_year\"].max() + 1, 10))\n","\n","# Clean styling\n","ax.grid(True, which=\"major\", linestyle=\":\", linewidth=0.9)\n","ax.spines[\"top\"].set_visible(False)\n","ax.spines[\"right\"].set_visible(False)\n","\n","# Model caption\n","caption = (f\"Model: T={T:.0e} Mt, K_E={K_E:,} Mt/yr, K_R={K_R:,} Mt/yr, \"\n","           f\"C_E={C_E/1e6:.3f}M$/Mt, C_R={C_R/1e6:.2f}M$/Mt\")\n","ax.text(0.01, -0.14, caption, transform=ax.transAxes, fontsize=9, va=\"top\")\n","\n","plt.tight_layout()\n","plt.savefig(\"stage1_pareto_frontier_fancy.png\", dpi=300, bbox_inches=\"tight\")\n","plt.show()\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"TzJ-Nz9LKcf1","executionInfo":{"status":"ok","timestamp":1770601025899,"user_tz":480,"elapsed":18455,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}},"outputId":"49850688-3741-425c-ec58-7c404c0168e1"},"outputs":[{"output_type":"stream","name":"stdout","text":["{'launches_per_year': 1341, 'climbs_per_year': 10740, 'p_elevator_fail_per_year': 0.010682537431958683, 'expected_elevator_failures_over_149y': 1.5916980773618437, 'mean_years': 150.00422, 'p95_years': 150.0, 'prob_151_or_more': 0.00422, 'mean_total_cost': 329102663630074.25, 'p95_total_cost': 329233434000000.0}\n"]}],"source":["def monte_carlo_q2(\n","    T=100_000_000,                 # tons\n","    years_plan=149,\n","    K_E=537_000,                    # tons/year elevator throughput (3 harbours)\n","    tons_per_launch=100,            # rocket payload\n","    pR_fail=0.02,                   # rocket failure per launch (2050)\n","    pE_fail_per_climb=1e-6,         # 0.0001% per climb\n","    shutdown_days=30,\n","    repair_cost=5e9,                # $5B per elevator failure\n","    maint_per_year=85e6,            # $85M/year\n","    # costs\n","    launch_cost=795e6,              # $/launch (paid even if failed)\n","    C_E=2.10188e6,                  # $/ton delivered via elevator channel (your model)\n","    tons_per_climb=50,              # q: tons/climb\n","    N=50000,                        # trials\n","    seed=0,\n","    max_years=400,\n","    return_arrays=False\n","):\n","    rng = np.random.default_rng(seed)\n","\n","    # Deterministic 149-year split: elevator saturated, rockets deliver remainder\n","    rocket_total = T - years_plan * K_E\n","    rocket_per_year = rocket_total / years_plan\n","    launches_per_year = int(round(rocket_per_year / tons_per_launch))\n","\n","    # Climbs per year (when not down)\n","    climbs_per_year = int(round(K_E / tons_per_climb))\n","\n","    # Annual probability of at least one elevator failure\n","    q_fail_year = 1 - (1 - pE_fail_per_climb) ** climbs_per_year\n","\n","    # If failure occurs, lose 30 days worth of elevator throughput that year\n","    loss_frac = shutdown_days / 365.0\n","    elev_full = K_E\n","    elev_reduced = K_E * (1 - loss_frac)\n","\n","    rocket_cost_year = launches_per_year * launch_cost\n","\n","    years_needed = np.empty(N, dtype=np.int16)\n","    total_cost = np.empty(N, dtype=np.float64)\n","\n","    for i in range(N):\n","        delivered = 0.0\n","        cost = 0.0\n","        y = 0\n","\n","        while delivered < T and y < max_years:\n","            # Elevator: yearly failure event\n","            elev_failed = rng.random() < q_fail_year\n","            delivered_e = elev_reduced if elev_failed else elev_full\n","            delivered += delivered_e\n","\n","            # Elevator costs: variable cost only when it delivers + always-on maintenance\n","            cost += delivered_e * C_E\n","            cost += maint_per_year\n","            if elev_failed:\n","                cost += repair_cost\n","\n","            # Rockets: launches attempted always, delivery reduced by failures\n","            successes = rng.binomial(launches_per_year, 1 - pR_fail)\n","            delivered += successes * tons_per_launch\n","            cost += rocket_cost_year\n","\n","            y += 1\n","\n","        years_needed[i] = y\n","        total_cost[i] = cost\n","\n","    summary = {\n","        \"launches_per_year\": launches_per_year,\n","        \"climbs_per_year\": climbs_per_year,\n","        \"p_elevator_fail_per_year\": q_fail_year,\n","        \"expected_elevator_failures_over_149y\": q_fail_year * years_plan,\n","        \"mean_years\": float(years_needed.mean()),\n","        \"p95_years\": float(np.quantile(years_needed, 0.95)),\n","        \"prob_151_or_more\": float(np.mean(years_needed >= 151)),\n","        \"mean_total_cost\": float(total_cost.mean()),\n","        \"p95_total_cost\": float(np.quantile(total_cost, 0.95)),\n","    }\n","\n","    if return_arrays:\n","        return summary, years_needed, total_cost\n","    return summary\n","summary, years_needed, total_cost = monte_carlo_q2(tons_per_climb=50, N=50000, seed=0, return_arrays=True)\n","print(summary)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":666},"id":"fcScZHVlvAKr","executionInfo":{"status":"ok","timestamp":1770601386430,"user_tz":480,"elapsed":3054,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}},"outputId":"33db45ed-b484-4309-f0b9-6d3c8f9e9044"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 820x620 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["/content/stage1_pareto_frontier_fancy_compact.png\n"]}],"source":["fig, ax = plt.subplots(figsize=(8.2, 6.2), constrained_layout=True)\n","\n","# Pareto curve (line only)\n","ax.plot(df[\"completion_year\"], df[\"total_cost_trillion\"], linewidth=2.2, zorder=2)\n","\n","# Key points\n","x0, y0 = float(df[\"completion_year\"].iloc[0]),  float(df[\"total_cost_trillion\"].iloc[0])\n","x1, y1 = float(df[\"completion_year\"].iloc[-1]), float(df[\"total_cost_trillion\"].iloc[-1])\n","\n","ax.plot([x0], [y0], marker=\"o\", markersize=7.5, linestyle=\"None\", zorder=4)\n","ax.plot([x1], [y1], marker=\"o\", markersize=7.5, linestyle=\"None\", zorder=4)\n","ax.plot([year_bal], [cost_bal], marker=\"o\", markersize=9.0, linestyle=\"None\", zorder=5)\n","\n","# Vertical guide lines\n","ax.axvline(x0,       linestyle=\"--\", linewidth=1.0, alpha=0.7, zorder=1)\n","ax.axvline(year_bal, linestyle=\"--\", linewidth=1.0, alpha=0.7, zorder=1)\n","ax.axvline(x1,       linestyle=\"--\", linewidth=1.0, alpha=0.7, zorder=1)\n","\n","# ---- Secondary x-axis (TOP) : reduce tick density + add padding ----\n","def year_to_tau(x): return x - start_year\n","def tau_to_year(x): return x + start_year\n","secax = ax.secondary_xaxis('top', functions=(year_to_tau, tau_to_year))\n","secax.set_xlabel(\"Project duration τ (years)\", labelpad=14)\n","\n","# Force top ticks every 20 years (NOT 10) to avoid crowding\n","tau_min_tick = int(np.ceil(year_to_tau(ax.get_xlim()[0]) / 10) * 10)\n","tau_max_tick = int(np.floor(year_to_tau(ax.get_xlim()[1]) / 10) * 10)\n","top_ticks = np.arange(tau_min_tick, tau_max_tick + 1, 20)\n","secax.set_xticks(top_ticks)\n","\n","# push tick labels upward a bit\n","secax.tick_params(axis=\"x\", pad=8)\n","\n","# ---- Labels and title ----\n","ax.set_title(\"Stage 1 Pareto Frontier (Hybrid Logistics): Completion Year vs Total Cost\", pad=12)\n","ax.set_xlabel(\"Completion year\")\n","ax.set_ylabel(\"Total cost (trillion $)\")\n","\n","# Limits/ticks\n","ax.set_xlim(df[\"completion_year\"].min() - 3, df[\"completion_year\"].max() + 3)\n","ax.set_xticks(np.arange(df[\"completion_year\"].min(), df[\"completion_year\"].max() + 1, 10))\n","\n","ymin, ymax = df[\"total_cost_trillion\"].min(), df[\"total_cost_trillion\"].max()\n","ax.set_ylim(ymin - 5, ymax + 10)\n","\n","ax.grid(True, which=\"major\", linestyle=\":\", linewidth=0.9)\n","ax.spines[\"top\"].set_visible(False)\n","ax.spines[\"right\"].set_visible(False)\n","\n","# ---- Annotations: place them AWAY from top axis ----\n","bbox_kw = dict(boxstyle=\"round,pad=0.25\", fc=\"white\", ec=\"none\", alpha=0.9)\n","arrow_kw = dict(arrowstyle=\"->\", linewidth=1.0, shrinkA=6, shrinkB=4)\n","\n","# 1) Earliest feasible：把文字放到点的右下区域（远离线），并加白底框\n","ax.annotate(\n","    f\"Earliest feasible\\nτ={tau_min} (Year {int(x0)})\",\n","    xy=(x0, y0),\n","    xytext=(40, -35), textcoords=\"offset points\",\n","    ha=\"left\", va=\"top\",\n","    fontsize=10,\n","    bbox=bbox_kw,\n","    arrowprops=arrow_kw,\n","    zorder=10\n",")\n","\n","# 2) Balanced choice：本来就还行，但加 bbox 保证不压线\n","ax.annotate(\n","    f\"Balanced choice\\nτ={tau_bal} (Year {year_bal})\\nCost ≈ {cost_bal:.1f}T\",\n","    xy=(year_bal, cost_bal),\n","    xytext=(25, 25), textcoords=\"offset points\",\n","    ha=\"left\", va=\"bottom\",\n","    fontsize=10,\n","    bbox=bbox_kw,\n","    arrowprops=arrow_kw,\n","    zorder=10\n",")\n","\n","# 3) Elevator-only limit：把文字放到点的左上区域（不要沿着线放），并加 bbox\n","ax.annotate(\n","    f\"Elevator-only limit\\nτ={tau_E} (Year {int(x1)})\",\n","    xy=(x1, y1),\n","    xytext=(-70, 35), textcoords=\"offset points\",\n","    ha=\"right\", va=\"bottom\",\n","    fontsize=10,\n","    bbox=bbox_kw,\n","    arrowprops=arrow_kw,\n","    zorder=10\n",")\n","\n","out_path = \"/content/stage1_pareto_frontier_fancy_compact.png\"\n","plt.savefig(out_path, dpi=300)   # <-- do NOT use bbox_inches=\"tight\"\n","plt.show()\n","print(out_path)\n"]}],"metadata":{"colab":{"provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}