":{"colab":{"base_uri":"https://localhost:8080/"},"id":"lZo7DGKhU7UZ","executionInfo":{"status":"ok","timestamp":1770597737567,"user_tz":480,"elapsed":10,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}},"outputId":"8aa846a5-a9e4-43d6-98c4-3f9e8fb60cc9"},"execution_count":23,"outputs":[{"output_type":"stream","name":"stdout","text":["7572001.292100002\n"]}]},{"cell_type":"code","source":["def solve_balanced_within_budget(\n","    target_payload=55928,\n","    monthly_budget=100_000_000_000,\n","    rocket_cap=100,\n","    climber_cap=49,\n","    # rocket_cost=7950,\n","    climber_cost=2101880, #C)E = $2.10188M/M t\n","    climbers_per_day_limit=5 # based on the total 179,000, each tether 5\n","):\n","    model = cp_model.CpModel()\n","    days = 31\n","    sites = ['Alaska', 'California', 'Texas', 'Florida', 'Virginia', 'Kazakhstan', 'France', 'India', 'China', 'New Zealand']\n","    # num_sites = 10    # Increased to 45 to handle the ~628 required launches\n","    num_tethers = 6\n","\n","    site_launch_costs = {s: int(cpd_site(s, rocket_cap)) for s in sites}\n","    #climber_event_cost = climber_cap * climber_cost\n","    climber_event_cost = int(climber_cap * climber_cost)\n","\n","    R = {(s, d): model.NewBoolVar(f'R_{s}_{d}') for s in sites for d in range(1, days+1)}    # Climber is now an Integer (Multi-launch per day)\n","    C = {(t, d): model.NewIntVar(0, climbers_per_day_limit, f'C_{t}_{d}') for t in range(num_tethers) for d in range(1, days+1)}\n","\n","    total_r = sum(R.values())\n","    total_c = sum(C.values())\n","\n","    # constraints\n","    # A. Mass\n","    model.Add(total_r * rocket_cap + total_c * climber_cap >= target_payload)\n","\n","    # B. Budget\n","    # model.Add(total_r * rocket_event_cost + total_c * climber_event_cost <= monthly_budget)\n","    rocket_costs = sum(R[s, d] * site_launch_costs[s] for s in sites for d in range(1, days+1))\n","    model.Add(rocket_costs + (total_c * climber_event_cost) <= monthly_