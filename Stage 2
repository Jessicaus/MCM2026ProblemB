ly_climbers = sum(solver.Value(C[t, d]) for t in range(num_tethers))\n","            print(f\"{d:<5} | {sites_str:<35} | {daily_climbers} climbers\")\n","\n","        print(\"=\"*50)\n","    else:\n","        print(\"Infeasible: The physical capacity of your sites/tethers is still too low.\")"],"metadata":{"id":"xL3OsfYWForp","executionInfo":{"status":"ok","timestamp":1770597737628,"user_tz":480,"elapsed":52,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}}},"execution_count":24,"outputs":[]},{"cell_type":"code","source":["solve_balanced_within_budget()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Pzic9OEl0iGr","executionInfo":{"status":"ok","timestamp":1770597767684,"user_tz":480,"elapsed":30051,"user":{"displayName":"JESSICA LI","userId":"04494111365292334724"}},"outputId":"8975fa18-2a33-491d-c8f0-1b3c9d11656a"},"execution_count":25,"outputs":[{"output_type":"stream","name":"stdout","text":["--- SUCCESS: 55928 TONS DELIVERED ---\n","Rockets: 152 launches\n","Climbers: 833 climbs\n","Peak Daily Operations: 32\n","Total Monthly Cost: $86,980,310,456.00\n","\n","==================================================\n","DAY   | ROCKET SITES ACTIVE                 | CLIMBER EVENTS\n","--------------------------------------------------\n","1     | California, Florida, Virginia, Kazakhstan, France, India, China, New Zealand | 24 climbers\n","2     | Alaska, Texas                       | 29 climbers\n","3     | California, Florida, Virginia, Kazakhstan, France, India, China, New Zealand | 24 climbers\n","4     | Alaska, Texas                       | 30 climbers\n","5     | Florida, Virginia, Kazakhstan, France, India, China, New Zealand | 25 climbers\n","6     | Alaska, California, Texas           | 29 climbers\n","7     | Florida, Virginia, Kazakhstan, France, India, China, New Zealand | 25 climbers\n","8     | California, Texas                   | 30 climbers\n","9     | Alaska, Florida, Virginia, Kazakhstan, India, China, New Zeala