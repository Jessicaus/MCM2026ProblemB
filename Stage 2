wIntVar(0, climbers_per_day_limit, f'C_{t}_{d}') for t in range(num_tethers) for d in range(1, days+1)}\n","\n","    total_r = sum(R.values())\n","    total_c = sum(C.values())\n","\n","    model.Add(total_r * rocket_cap + total_c * climber_cap >= target_payload)\n","\n","    rocket_costs = sum(R[s, d] * site_launch_costs[s] for s in sites for d in range(1, days+1))\n","    model.Add(rocket_costs + (total_c * climber_event_cost) <= monthly_budget)\n","\n","    for s in sites:\n","        for d in range(1, days):\n","            model.Add(R[s, d] + R[s, d+1] <= 1)\n","\n","    # 3. OBJECTIVE\n","    max_daily_events = model.NewIntVar(0, len(sites) + num_tethers * climbers_per_day_limit, 'peak')\n","    for d in range(1, days + 1):\n","        day_sum = sum(R[s, d] for s in sites) + sum(C[t, d] for t in range(num_tethers))\n","        model.Add(day_sum <= max_daily_events)\n","\n","    model.Minimize(max_daily_events)\n","\n","    # 4. SOLVE\n","    solver = cp_model.CpSolver()\n","    solver.parameters.max_time_in_seconds = 15.0 # Shorter for sensitivity loops\n","    status = solver.Solve(model)\n","\n","    if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:\n","        actual_total_cost = sum(solver.Value(R[s, d]) * site_launch_costs[s] for s in sites for d in range(1, days+1))\n","        actual_total_cost += solver.Value(total_c) * climber_event_cost\n","\n","        # Return data for the sensitivity analysis\n","        return {\n","            \"status\": \"SUCCESS\",\n","            \"peak_ops\": solver.Value(max_daily_events),\n","            \"total_cost\": actual_total_cost,\n","            \"rockets\": solver.Value(total_r),\n","            \"climbers\": solver.Value(total_c)\n","        }\n","    else:\n","        return {\"status\": \"INFEASIBLE\", \"peak_ops\": None, \"total_cost\": None}"],"metadata":{"id":"fisHsatXIksh","executionInfo":{"status":"ok","timestamp":1770597797717,"user_tz":480,"elapsed":2,"user":{"displayName":"JESSICA LI","use